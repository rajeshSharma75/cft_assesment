# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/chat_db

# Optional: keep the application's tables inside a specific schema (defaults to public).
# The automated tests use this automatically to isolate themselves from your data.
# DATABASE_SCHEMA=chat_test

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# ---------------------------------------------------------------------------
# Firebase Admin (service account)
# ---------------------------------------------------------------------------
# Copy these three values from the service account JSON file:
#   project_id  -> FIREBASE_PROJECT_ID
#   client_email-> FIREBASE_CLIENT_EMAIL
#   private_key  -> FIREBASE_PRIVATE_KEY (keep the \n escapes, wrap in quotes)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firestore database ID. Use "(default)" for the implicit database, or the
# exact ID of a named database created in the console (e.g. "default").
FIRESTORE_DATABASE_ID=(default)

# Optional: point the Admin SDK at the Firebase Emulator (local development only)
# FIRESTORE_EMULATOR_HOST=localhost:8080
